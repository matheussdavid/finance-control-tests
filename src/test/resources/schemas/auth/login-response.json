{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Login Response",
  "description": "Resposta de POST /auth/login com credenciais válidas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token",
    "user"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "email"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}