# === Configuração da automação (finance-control-tests) ===
# Precedência: variável de ambiente > .env > valor padrão no código.
# Credenciais do app (JWT_SECRET do backend) vivem no .env do app, NUNCA aqui.

# URL da aplicação web (frontend)
BASE_URL=http://localhost:5173

# URL da API
API_BASE_URL=http://localhost:8080

# Banco PostgreSQL (usado pelos testes de persistência)
DB_URL=jdbc:postgresql://localhost:5432/finance_control
DB_USER=finance
DB_PASSWORD=finance_pass

# Navegador: apenas Chrome (headless no CI). Driver resolvido pelo Selenium Manager.
# Opcional: caminho do binário do Chrome quando não instalado no local padrão
# CHROME_BINARY=/home/usuario/chrome/opt/google/chrome/chrome

# Headless (CI sempre true)
HEADLESS=true

# Timeout padrão para waits explícitos do Selenium (segundos)
WAIT_TIMEOUT_SECONDS=15

# Diretório de evidências (screenshots de falha)
SCREENSHOT_DIR=target/screenshots

# Senha sintética padrão dos usuários de teste (não é secret real)
DEFAULT_PASSWORD=Passw0rd!123

# Usuário-catálogo dos testes de consulta (criado via API pelo SeedFixture).
# Credenciais determinísticas; senha própria (não herda DEFAULT_PASSWORD).
SEEDED_ACCOUNT_EMAIL=seed.contas@qa.example.com
SEEDED_ACCOUNT_PASSWORD=SeedContas!123